// A blocking HTTP/1.1 client, written over `std/net`.
//
// Plain HTTP only. TLS is not here and is not an oversight: binding a system
// TLS library is a milestone of its own and arguably a dependency-policy
// decision rather than a technical one, so `https://` is refused by name
// instead of pretended at.
//
// A host name is resolved through `std/dns`, which speaks DNS over UDP
// because every resolver in libc answers with a pointer. The `Host` header
// carries the name the caller wrote, not the address it resolved to.

import "std/dns"
import "std/net"
import "std/strings"

pub class Header {
    name: string
    value: string
}

pub enum HttpError {
    // The URL was not `http://host[:port]/path`.
    Url(string),
    // `https://`, which needs TLS.
    Tls(string),
    // A host name that did not resolve.
    Name(dns.DnsError),
    Network(net.NetError),
    // The response was not an HTTP/1.1 message, or ended mid-message.
    Malformed(string),
    // A body that is not valid UTF-8.
    Encoding(string),
    // A method, header name or header value carrying a carriage return, a
    // newline or a NUL. Those bytes frame a request, so one inside a value
    // would end the header and start a second request the caller never wrote.
    Header(string),
}

pub func describe(error: HttpError) -> string {
    match error {
        HttpError.Url(text): return "`${text}` is not an http URL"
        HttpError.Tls(text): return "`${text}` needs TLS, which is not implemented"
        HttpError.Name(inner): return dns.describe(inner)
        HttpError.Network(inner): return net.describe(inner)
        HttpError.Malformed(what): return "malformed response: ${what}"
        HttpError.Encoding(what): return "response body is not UTF-8: ${what}"
        HttpError.Header(name): return "`${name}` is not a usable header name or value"
    }
}

pub class Response {
    status: int
    reason: string
    headers: []Header
    body: string

    // Header names are case-insensitive, so the comparison is too.
    header(name: string) -> Option<string> {
        for entry in this.headers {
            if lower(entry.name) == lower(name) {
                return entry.value
            }
        }
        return null
    }
}

func lower(text: string) -> string {
    var out: []u8 = []
    for byte in text.bytes() {
        if byte >= 65 && byte <= 90 {
            out.push(byte + 32)
        } else {
            out.push(byte)
        }
    }
    match bytes_to_string(out) {
        Ok(result): return result
        Err(reason): return text
    }
}

func digits(text: string) -> Option<int> {
    if text.len() == 0 {
        return null
    }
    var value = 0
    for byte in text.bytes() {
        if byte < 48 || byte > 57 {
            return null
        }
        value = value * 10 + (int(byte) - 48)
    }
    return value
}

pub class Url {
    host: string
    port: int
    path: string
}

pub func parse_url(url: string) -> Result<Url, HttpError> {
    if strings.starts_with(url, "https://") {
        return Err(HttpError.Tls(url))
    }
    if !strings.starts_with(url, "http://") {
        return Err(HttpError.Url(url))
    }
    let rest = url[7..url.len()]
    // The path begins at the first `/`; without one the whole remainder is
    // the authority and the path is `/`.
    var authority = rest
    var path = "/"
    if let slash = strings.index_of(rest, "/") {
        authority = rest[0..slash]
        path = rest[slash..rest.len()]
    }
    if authority.len() == 0 {
        return Err(HttpError.Url(url))
    }
    var host = authority
    var port = 80
    if let colon = strings.index_of(authority, ":") {
        host = authority[0..colon]
        let text = authority[colon + 1..authority.len()]
        if let value = digits(text) {
            port = value
        } else {
            return Err(HttpError.Url(url))
        }
    }
    if host.len() == 0 {
        return Err(HttpError.Url(url))
    }
    return Ok(new Url(host: host, port: port, path: path))
}

// A request that is more than a URL: a method, headers of the caller's own,
// and a body.
//
// It exists because an API is rarely reachable without one. A token goes in
// `Authorization`, an identity in whatever header the service names, and a
// service behind a content delivery network often refuses a request carrying
// no `User-Agent` at all. None of that can be said with a URL.
pub class Request {
    url: string
    method: string = "GET"
    // Sent in the order given, after the two this client sets for itself.
    headers: []Header = []
    // Empty for a method that carries none. When it is not, its length in
    // bytes is sent with it, because that is what a reader counts.
    body: string = ""
}

// A plain GET, which is most of them.
pub func get(url: string) -> Result<Response, HttpError> {
    return send(new Request(url: url))
}

pub func send(details: Request) -> Result<Response, HttpError> {
    let target = parse_url(details.url)?
    let bytes = compose(details, target.path, "${target.host}:${target.port}")?
    // The name is resolved here rather than in `std/net`: a socket takes an
    // address, and `std/dns` needs sockets, so the resolver sits above both.
    let address = dns.resolve(target.host) else reason {
        return Err(HttpError.Name(reason))
    }
    let connection = net.open(address, target.port) else reason {
        return Err(HttpError.Network(reason))
    }
    // One close, on every way out. This is what `defer` is for, and the
    // three hand-written calls it replaces were three chances to miss one.
    defer connection.close()
    let sent = connection.send_all(bytes) else reason {
        return Err(HttpError.Network(reason))
    }
    let raw = connection.receive_all() else reason {
        return Err(HttpError.Network(reason))
    }
    return parse_response(raw)
}

// The request text, as the bytes that go on the wire.
//
// `Host` is required by HTTP/1.1, and `Connection: close` is what makes a body
// without a length end — this client opens one connection per request anyway.
// Everything after those two is the caller's, in the order they gave.
//
// A method, name or value carrying a carriage return or a newline is refused
// rather than escaped. Those bytes are what frames a request, so one inside a
// value ends the header and begins whatever follows it as a second request,
// addressed to the same server and looking exactly as legitimate. Refusing is
// the only answer that cannot be got subtly wrong.
//
// Public for `std/https`, which sends the same bytes over a different kind of
// connection — the same reason `parse_response` is public. Duplicating the
// refusal above into that module would be duplicating a security check, and
// this repository has already watched a duplicated list go stale twice.
pub func compose(details: Request, path: string, authority: string) -> Result<[]u8, HttpError> {
    if details.method.len() == 0 || !unbroken(details.method) {
        return Err(HttpError.Header(details.method))
    }
    var text = "${details.method} ${path} HTTP/1.1\r\nHost: ${authority}\r\nConnection: close\r\n"
    for header in details.headers {
        if header.name.len() == 0 || !unbroken(header.name) || !unbroken(header.value) {
            return Err(HttpError.Header(header.name))
        }
        text = "${text}${header.name}: ${header.value}\r\n"
    }
    let body = details.body.bytes()
    if body.len() > 0 {
        // In bytes rather than characters, because that is what a reader
        // counts and a string here is UTF-8.
        text = "${text}Content-Length: ${body.len()}\r\n"
    }
    text = "${text}\r\n"
    var bytes: []u8 = []
    for byte in text.bytes() {
        bytes.push(byte)
    }
    for byte in body {
        bytes.push(byte)
    }
    return Ok(bytes)
}

// Whether text can be written into a request without changing its shape.
func unbroken(text: string) -> bool {
    var index = 0
    while index < text.len() {
        let byte = text[index]
        if byte == 13 || byte == 10 || byte == 0 {
            return false
        }
        index += 1
    }
    return true
}

// The head is ASCII by definition, so it is decoded before being split; the
// body is decoded separately and is the only part that can fail on UTF-8.
pub func parse_response(raw: []u8) -> Result<Response, HttpError> {
    var boundary = -1
    var index = 0
    while index + 3 < raw.len() {
        if raw[index] == 13 && raw[index + 1] == 10 && raw[index + 2] == 13 && raw[index + 3] == 10 {
            boundary = index
            break
        }
        index = index + 1
    }
    if boundary < 0 {
        return Err(HttpError.Malformed("no blank line after the headers"))
    }
    let head = bytes_to_string(raw[0..boundary]) else reason {
        return Err(HttpError.Malformed("headers are not text"))
    }
    let body_bytes = raw[boundary + 4..raw.len()]
    let lines = strings.split(head, "\r\n")
    if lines.len() == 0 {
        return Err(HttpError.Malformed("empty response"))
    }
    let status_line = strings.split(lines[0], " ")
    if status_line.len() < 2 {
        return Err(HttpError.Malformed("status line"))
    }
    if !strings.starts_with(status_line[0], "HTTP/1.") {
        return Err(HttpError.Malformed("not an HTTP/1.x response"))
    }
    let status = digits(status_line[1]) else {
        return Err(HttpError.Malformed("status code"))
    }
    var reason = ""
    if status_line.len() > 2 {
        var parts: []string = []
        var part = 2
        while part < status_line.len() {
            parts.push(status_line[part])
            part = part + 1
        }
        reason = strings.join(parts, " ")
    }
    var headers: []Header = []
    var line = 1
    while line < lines.len() {
        let current = lines[line]
        if current.len() != 0 {
            if let colon = strings.index_of(current, ":") {
                let name = strings.trim(current[0..colon])
                let value = strings.trim(current[colon + 1..current.len()])
                headers.push(new Header(name: name, value: value))
            } else {
                return Err(HttpError.Malformed("header without a colon"))
            }
        }
        line = line + 1
    }
    // A declared length wins over what arrived, so a longer read is truncated
    // and a shorter one is reported rather than quietly accepted.
    var body = body_bytes
    for entry in headers {
        if lower(entry.name) == "content-length" {
            if let length = digits(entry.value) {
                if length > body_bytes.len() {
                    return Err(HttpError.Malformed("body shorter than Content-Length"))
                }
                body = body_bytes[0..length]
            } else {
                return Err(HttpError.Malformed("Content-Length is not a number"))
            }
        }
    }
    let text = bytes_to_string(body) else invalid {
        return Err(HttpError.Encoding(invalid))
    }
    return Ok(new Response(status: status, reason: reason, headers: headers, body: text))
}
