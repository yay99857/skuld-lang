// The process itself: the arguments it was started with, and leaving early.
//
// Both go through the runtime rather than straight to libc, and that is the
// interesting part. Reading `argv` means following a pointer to a pointer,
// which `AGENTS.md` keeps out of the foreign boundary, so the runtime offers
// a count, a length and a copy into bytes Skuld already owns. The boundary
// stays exactly as narrow as it was: scalars and a pointer to bytes the
// caller owns, with nothing managed crossing it.

import "std/cstring"

unsafe extern "C" {
    func sk_arg_count() -> i64
    func sk_arg_len(index: i64) -> i64
    func sk_arg_copy(index: i64, out: *u8, capacity: u64) -> i64
    func sk_errno() -> i64
    func sk_error_message(code: i64, out: *u8, capacity: u64) -> i64
    func sk_flush() -> void
    func sk_exit(code: i64) -> void
    func sk_environment(name: *u8, out: *u8, capacity: u64) -> i64
    // Running a program is POSIX rather than C, and none of these is declared
    // by a header the generated program includes, so each one is asserted
    // here like any other foreign signature.
    //
    // A pipe is read and closed through `sk_file_read` and `sk_file_close`:
    // a pipe end is a descriptor like any other, and naming `read` and
    // `close` here would be a second prototype for a function the platform
    // layer's headers already declare, agreeing only where the widths happen
    // to match. These two repeat `std/fs`'s declarations byte for byte, which
    // is the one way two modules of one program may name one C function.
    func sk_file_read(handle: i64, buffer: *u8, capacity: u64) -> i64
    func sk_file_close(handle: i64) -> void
    func pipe(handles: *i32) -> i32
    func fork() -> i32
    func dup2(from: i32, to: i32) -> i32
    func execvp(file: *u8, argv: *void) -> i32
    func waitpid(child: i32, status: *i32, options: i32) -> i32
    func _exit(code: i32) -> void
    func malloc(size: usize) -> *void
    func free(block: *void) -> void
}

// One slot of the `argv` array, which is the one shape the foreign boundary
// refuses to describe: a pointer to a pointer. Declaring the cell is how this
// module asks the C compiler how wide one is, on whatever target it is being
// built for.
extern struct PointerCell {
    value: *void
}

pub enum OsError {
    // An argument that is not UTF-8. Skuld strings are UTF-8, and a command
    // line is bytes, so the two can disagree.
    NotText(int),
}

pub func describe(error: OsError) -> string {
    match error {
        OsError.NotText(index): return "argument ${index} is not valid UTF-8"
    }
}

// Every argument, starting with the program as it was invoked, the way C and
// every shell count them. `arguments()[0]` is therefore the program itself.
pub func arguments() -> Result<[]string, OsError> {
    var all: []string = []
    var index = 0
    let count = int(sk_arg_count())
    while index < count {
        let length = int(sk_arg_len(i64(index)))
        if length < 0 {
            return Err(OsError.NotText(index))
        }
        var bytes: []u8 = []
        var filled = 0
        while filled < length {
            bytes.push(0)
            filled += 1
        }
        if length > 0 {
            let copied = sk_arg_copy(i64(index), ptr(bytes), u64(length))
            if copied != i64(length) {
                return Err(OsError.NotText(index))
            }
        }
        let text = bytes_to_string(bytes) else message {
            return Err(OsError.NotText(index))
        }
        all.push(text)
        index += 1
    }
    return Ok(all)
}

// The arguments the program was given, without the program itself, which is
// what a tool actually reads.
pub func parameters() -> Result<[]string, OsError> {
    let all = arguments()?
    if all.len() == 0 {
        return Ok(all)
    }
    return Ok(all[1..all.len()])
}

// Why the last foreign call failed, as the operating system's number. It is
// only meaningful immediately after a call that reported failure: anything in
// between may have set it.
pub const EPERM: int = 1

pub const ENOENT: int = 2

pub const ESRCH: int = 3

pub const EINTR: int = 4

pub const EIO: int = 5

pub const EBADF: int = 9

pub const EAGAIN: int = 11

pub const ENOMEM: int = 12

pub const EACCES: int = 13

pub const EFAULT: int = 14

pub const EEXIST: int = 17

pub const ENOTDIR: int = 20

pub const EISDIR: int = 21

pub const EINVAL: int = 22

pub const EMFILE: int = 24

pub const ENOSPC: int = 28

pub const EPIPE: int = 32

pub const ETIMEDOUT: int = 110

pub const ECONNREFUSED: int = 111

pub func last_error() -> int {
    return int(sk_errno())
}

// The system's description of an error number, such as "Connection refused".
// An unknown number still describes itself, since that is what `strerror`
// does; an empty string means the description did not fit, which no real one
// does.
pub func error_message(code: int) -> string {
    var buffer: []u8 = []
    var index = 0
    while index < 256 {
        buffer.push(0)
        index += 1
    }
    let length = sk_error_message(i64(code), ptr(buffer), u64(256))
    if length < 0 {
        return ""
    }
    let text = bytes_to_string(buffer[0..int(length)]) else problem {
        return ""
    }
    return text
}

// A failed system call: what was being attempted, and the number the system
// left behind. It is a class so that an enum variant can carry both halves
// without the language needing a tuple.
pub class OsFailure {
    // What the call was working on — a path, an address, a step's name.
    subject: string
    // The system's error number at the moment the call failed, or 0 when
    // there was none to read.
    code: int = 0
}

// Capture the reason the call that just failed did so. Call it immediately:
// anything in between may set `errno` itself.
pub func failure(subject: string) -> OsFailure {
    return new OsFailure(subject: subject, code: last_error())
}

// `subject: reason`, or just the subject where the system had no number.
pub func describe_failure(problem: OsFailure) -> string {
    if problem.code == 0 {
        return problem.subject
    }
    return "${problem.subject}: ${error_message(problem.code)}"
}

// Write out what has been printed so far. Output is buffered, so a program
// that is about to abort — or about to hand over to something else — flushes
// first or loses it.
pub func flush() {
    sk_flush()
}

// Stop now with this status. Output is flushed first; nothing is released,
// because the process is ending. A status outside 0..255 is truncated by the
// operating system, not here.
pub func exit(code: int) {
    sk_exit(i64(code))
}

// What a program that was run wrote, and how it ended.
pub class Output {
    // The exit status, or -1 when the program was killed by a signal rather
    // than exiting. A program that could not be started exits 127, the way a
    // shell reports the same thing.
    status: int
    // Everything it wrote to standard output. Its standard error is left
    // alone, so a program that complains still complains where a person can
    // see it.
    text: string
    // Whether it wrote more than fitted. The rest was read and discarded, so
    // the program never blocked on a pipe nobody was draining.
    truncated: bool = false
}

// How much of a program's output is kept. A status line is a few hundred
// bytes; this is generous for that and small enough to sit on the stack.
const CAPTURE_LIMIT: int = 65536

pub enum RunError {
    // The program name or one of the arguments contained a NUL, so it could
    // not be handed to C at all.
    NotPassable(string),
    // A system call failed before the program could run.
    Failed(OsFailure),
    // The program ran and wrote something that is not UTF-8.
    NotText(string),
}

pub func describe_run(error: RunError) -> string {
    match error {
        RunError.NotPassable(text): return "`${text}` cannot be passed to a program: ${text}"
        RunError.Failed(problem): return "could not run ${describe_failure(problem)}"
        RunError.NotText(name): return "`${name}` wrote output that is not UTF-8"
    }
}

// Run a program and read what it writes, waiting for it to finish.
//
// The program is looked up on `PATH`, and its arguments are passed as written:
// there is no shell here, so nothing is expanded, quoted or split, and a
// string containing a space is one argument. That is the point — a bar script
// asking for a machine's state should not be a place where quoting can go
// wrong.
pub func run(program: string, arguments: []string) -> Result<Output, RunError> {
    // The C strings have to outlive the array of addresses built from them,
    // so they are all made first and none is touched afterwards.
    var owned: [][]u8 = []
    let program_bytes = cstring.to_c(program) else problem {
        return Err(RunError.NotPassable(program))
    }
    owned.push(program_bytes)
    for argument in arguments {
        let bytes = cstring.to_c(argument) else problem {
            return Err(RunError.NotPassable(argument))
        }
        owned.push(bytes)
    }
    var handles: [2]i32 = [0, 0]
    if pipe(ptr(handles)) != 0 {
        return Err(RunError.Failed(failure("a pipe")))
    }
    let cell = size_of(PointerCell)
    let argv = malloc(cell * usize(owned.len() + 1))
    unsafe {
        let slots: *usize = ptr_from(addr(argv))
        var index = 0
        while index < owned.len() {
            store(offset(slots, index), addr(ptr(owned[index])))
            index += 1
        }
        // The array ends in a null address, which is how `execvp` knows where
        // the arguments stop.
        store(offset(slots, owned.len()), usize(0))
    }
    let child = fork()
    if child < 0 {
        free(argv)
        sk_file_close(i64(handles[0]))
        sk_file_close(i64(handles[1]))
        return Err(RunError.Failed(failure(program)))
    }
    if child == 0 {
        // The child: its standard output becomes the pipe, and then it is
        // replaced by the program. `_exit` rather than `exit`, so a failed
        // start does not flush this program's buffers a second time.
        let ignored_out = dup2(handles[1], 1)
        sk_file_close(i64(handles[0]))
        sk_file_close(i64(handles[1]))
        let ignored_exec = execvp(ptr(owned[0]), argv)
        _exit(127)
    }
    free(argv)
    sk_file_close(i64(handles[1]))
    var collected: []u8 = []
    var buffer: [4096]u8 = [0; 4096]
    var truncated = false
    loop {
        let got = sk_file_read(i64(handles[0]), ptr(buffer), u64(4096))
        if got <= 0 {
            break
        }
        var index = 0
        while i64(index) < got {
            // Reading continues past the limit and the rest is dropped: a
            // child whose pipe nobody drains stops rather than finishes.
            if collected.len() < CAPTURE_LIMIT {
                collected.push(buffer[index])
            } else {
                truncated = true
            }
            index += 1
        }
    }
    sk_file_close(i64(handles[0]))
    var status: i32 = 0
    unsafe {
        let ignored_wait = waitpid(child, ptr(status), 0)
    }
    let text = bytes_to_string(collected) else invalid {
        return Err(RunError.NotText(program))
    }
    return Ok(new Output(status: exit_status(int(status)), text: text, truncated: truncated))
}

// The status `waitpid` leaves behind, as the number the program exited with.
// A program killed by a signal did not exit, and says so with -1.
func exit_status(raw: int) -> int {
    if (raw & 127) != 0 {
        return -1
    }
    return (raw >> 8) & 255
}

// The value of an environment variable, or nothing when it is unset.
//
// It is read from `/proc/self/environ` rather than from `getenv`, whose
// prototype takes a `char *` — a type Skuld cannot name, since its own `char`
// is a Unicode scalar and not a byte. The file is the same information, and
// reading it needs nothing the boundary refuses.
pub func environment(name: string) -> Option<string> {
    let wanted = cstring.to_c(name) else problem {
        return null
    }
    var buffer: [4096]u8 = [0; 4096]
    let got = sk_environment(ptr(wanted), ptr(buffer), u64(4096))
    if got < 0 {
        return null
    }
    let text = bytes_to_string(buffer[0..int(got)]) else invalid {
        return null
    }
    return text
}

func index_of_byte(text: string, byte: u8) -> Option<int> {
    var index = 0
    while index < text.len() {
        if text[index] == byte {
            return index
        }
        index += 1
    }
    return null
}
