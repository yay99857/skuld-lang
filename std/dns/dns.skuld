// Turning a host name into an address, by speaking DNS over UDP.
//
// Why this and not `getaddrinfo`: every resolver in libc answers with a
// pointer to a structure, and reading through a pointer is what the foreign
// boundary does not do. The alternatives were a memory primitive at the
// boundary — which would weaken the one rule that makes the FFI safe — or
// this: a resolver written in Skuld, using the sockets the boundary already
// reaches. A UDP socket is `connect`ed to the server, so `send` and `recv`
// are enough and `recvfrom`'s address-out parameter is never needed.
//
// An answer is matched against the question before it is believed: the query
// id, the question section, and that the message claims to be a response at
// all. A UDP datagram arrives from whoever sent one, and `connect` on the
// socket only fixes the address and the port, so those three are what RFC 5452
// asks a resolver to check and what stands between a caller and a forged
// reply. They were absent once: the id was written into the question and then
// discarded, so a spoofed answer to a different name was accepted.
//
// What remains weak is the id itself, which comes from the clock because the
// language has no random source — the current second, shared by every query
// in it. Checking it is what makes it worth randomising, and randomising it
// without checking would have been worth nothing.
//
// What this is not: a caching resolver or a full DNS client. It is meant for
// the nameserver the machine is already configured to trust.

import "std/net"
import "std/os"
import "std/strings"

pub const DNS_PORT: int = 53

pub const TIMEOUT_MILLISECONDS: int = 3000

// Everything that touches the system goes through the platform layer, and
// what used to be written here went with it. `struct timeval` was the sharpest
// of the reasons: its fields are `long`, which is sixty-four bits on a 64-bit
// Unix and thirty-two on Windows, so the structure is sixteen bytes on one
// and eight on the other — and Windows does not take a `timeval` for this
// option at all, it takes a count of milliseconds. A declaration here would
// have to be one of those and would be silently wrong as the other. So a
// timeout crosses as milliseconds, which both systems can say.
//
// `servers()` moved for a different reason: the answer lives in a text file on
// one system and behind an API on the other, which is not a difference a
// declaration can bridge at all.
unsafe extern "C" {
    func sk_socket_connect(octets: *u8, port: i64, datagram: i64) -> i64
    func sk_socket_send(handle: i64, buffer: *u8, length: u64) -> i64
    func sk_socket_recv(handle: i64, buffer: *u8, capacity: u64) -> i64
    func sk_socket_timeout(handle: i64, milliseconds: i64) -> i64
    func sk_socket_close(handle: i64) -> void
    func sk_dns_servers(out: *u8, capacity: u64) -> i64
    // Seconds since the epoch, written into the eight bytes handed to it. The
    // return value is the same number, which is the one this module uses.
    func time(out: *u8) -> i64
}

pub enum DnsError {
    // The machine named no server this module could use.
    NoServer(string),
    // The name is empty, too long, or has a label that is.
    BadName(string),
    // The socket, the connect, the send or the receive failed.
    Transport(os.OsFailure),
    // The server answered with a non-zero RCODE. 2 is SERVFAIL, 3 is NXDOMAIN.
    Refused(int),
    // The answer could not be read as a DNS message.
    Malformed(string),
    // The answer was well formed and was not a reply to this query: a
    // different id, a different question, or not a response at all.
    Mismatched(string),
    // The name resolved, but to nothing this module can use: no A record.
    NoAddress(string),
}

pub func describe(error: DnsError) -> string {
    match error {
        DnsError.NoServer(detail): return "no nameserver: ${detail}"
        DnsError.BadName(name): return "`${name}` is not a usable host name"
        DnsError.Transport(problem): return "dns query failed: ${os.describe_failure(problem)}"
        DnsError.Refused(code): return "the nameserver answered with code ${code}${rcode_hint(code)}"
        DnsError.Malformed(detail): return "the answer could not be read: ${detail}"
        DnsError.Mismatched(detail): return "the answer was not a reply to this query: ${detail}"
        DnsError.NoAddress(name): return "`${name}` has no IPv4 address"
    }
}

func rcode_hint(code: int) -> string {
    if code == 2 {
        return " (server failure)"
    }
    if code == 3 {
        return " (no such name)"
    }
    return ""
}

// The nameservers this machine is configured with, in the order it lists
// them. Finding them is the platform layer's, because the answer is a text
// file on one system and an adapter API on the other — a difference no
// declaration could bridge. No servers is an empty list rather than an error:
// the caller decides what to do without one.
pub func servers() -> []string {
    var found: []string = []
    var buffer: [1024]u8 = [0; 1024]
    let got = sk_dns_servers(ptr(buffer), u64(1024))
    if got <= 0 {
        return found
    }
    // NUL-separated dotted quads, which is the one shape both systems can
    // produce and this module can already parse.
    var start = 0
    var index = 0
    while index < int(got) {
        if buffer[index] == 0 {
            if index > start {
                let text = bytes_to_string(buffer[start..index]) else invalid {
                    start = index + 1
                    index += 1
                    continue
                }
                found.push(text)
            }
            start = index + 1
        }
        index += 1
    }
    return found
}

// The first IPv4 address of a host name, asking the machine's own servers.
pub func resolve(name: string) -> Result<string, DnsError> {
    let configured = servers()
    if configured.len() == 0 {
        return Err(DnsError.NoServer("this machine lists no IPv4 nameserver"))
    }
    var last = DnsError.NoServer("no server was tried")
    for server in configured {
        match resolve_with(server, DNS_PORT, name) {
            Ok(address): return Ok(address)
            Err(problem): {
                // A name that does not exist is that server's final answer;
                // a transport failure is worth trying the next server for.
                match problem {
                    DnsError.Refused(code): return Err(DnsError.Refused(code))
                    DnsError.BadName(bad): return Err(DnsError.BadName(bad))
                    DnsError.NoAddress(missing): return Err(DnsError.NoAddress(missing))
                    _: last = problem
                }
            }
        }
    }
    return Err(last)
}

// The same, against one server, which is what a test points at a server of
// its own.
pub func resolve_with(server: string, port: int, name: string) -> Result<string, DnsError> {
    if name.len() == 0 || name.len() > 253 {
        return Err(DnsError.BadName(name))
    }
    // An address needs no resolving, and a resolver that tried would be a
    // surprising way to fail offline.
    if is_address(name) {
        return Ok(name)
    }
    let id = query_id()
    let question = query(name, id)?
    let answer = exchange(server, port, question)?
    return read_answer(answer, name, id, question)
}

// Four decimal octets: `net.parse_address` already knows, and its error is
// not this module's to report.
pub func is_address(text: string) -> bool {
    match net.parse_address(text) {
        Ok(octets): return true
        Err(problem): return false
    }
}

// One question for one A record, under the id the caller will match against.
func query(name: string, id: int) -> Result<[]u8, DnsError> {
    var message: []u8 = []
    message.push(u8(id / 256))
    message.push(u8(id % 256))
    // Recursion desired, everything else clear.
    message.push(1)
    message.push(0)
    // One question, no answers, no authority, no additional.
    message.push(0)
    message.push(1)
    var zeros = 0
    while zeros < 6 {
        message.push(0)
        zeros += 1
    }
    for label in strings.split(name, ".") {
        if label.len() == 0 || label.len() > 63 {
            return Err(DnsError.BadName(name))
        }
        message.push(u8(label.len()))
        for byte in label.bytes() {
            message.push(byte)
        }
    }
    message.push(0)
    // QTYPE A, QCLASS IN.
    message.push(0)
    message.push(1)
    message.push(0)
    message.push(1)
    return Ok(message)
}

// The number this query is known by, which an answer has to carry back.
//
// It comes from the clock, which means an off-path attacker can guess it: the
// value is the current second, and every query in that second shares it. That
// is a weakness and it is named here rather than in a comment far from the
// code, because the language has no random source to fix it with yet.
func query_id() -> int {
    var seconds: []u8 = []
    var index = 0
    while index < 8 {
        seconds.push(0)
        index += 1
    }
    let now = time(ptr(seconds))
    return int(now % 65536)
}

// Send one datagram and wait for one, with a timeout so an unreachable server
// is a failure rather than a hang.
func exchange(server: string, port: int, question: []u8) -> Result<[]u8, DnsError> {
    let octets = address_bytes(server)?
    let handle = sk_socket_connect(ptr(octets), i64(port), 1)
    if handle < 0 {
        return Err(DnsError.Transport(net.failure("${server}:${port}")))
    }
    // A server that never answers has to become a failure rather than a hang.
    let ignored_option = sk_socket_timeout(handle, i64(TIMEOUT_MILLISECONDS))
    let sent = sk_socket_send(handle, ptr(question), u64(question.len()))
    if sent < 0 {
        let problem = net.failure("${server}:${port}")
        sk_socket_close(handle)
        return Err(DnsError.Transport(problem))
    }
    var buffer: []u8 = []
    var index = 0
    while index < 512 {
        buffer.push(0)
        index += 1
    }
    let got = sk_socket_recv(handle, ptr(buffer), u64(512))
    let problem = net.failure("${server}:${port}")
    sk_socket_close(handle)
    if got < 0 {
        return Err(DnsError.Transport(problem))
    }
    return Ok(buffer[0..int(got)])
}

func address_bytes(server: string) -> Result<[]u8, DnsError> {
    match net.parse_address(server) {
        Ok(octets): return Ok(octets)
        Err(problem): return Err(DnsError.NoServer("`${server}` is not an IPv4 address"))
    }
}

// The first A record in the answer section, as four decimal octets.
func read_answer(message: []u8, name: string, id: int, question: []u8) -> Result<string, DnsError> {
    if message.len() < 12 {
        return Err(DnsError.Malformed("the answer is shorter than a header"))
    }
    // Three checks before anything in the answer is believed, because a UDP
    // datagram arrives from whoever sent one and the socket being `connect`ed
    // only fixes the address and the port. RFC 5452 names the rest: the id,
    // the question, and that this is a response at all. Without them the only
    // thing an attacker has to guess is the ephemeral port.
    let answered = int(message[0]) * 256 + int(message[1])
    if answered != id {
        return Err(DnsError.Mismatched("it carries a different query id"))
    }
    // The high bit of the third byte is QR, set on a response.
    if int(message[2]) / 128 == 0 {
        return Err(DnsError.Mismatched("it is a query rather than a response"))
    }
    if !echoes_question(message, question) {
        return Err(DnsError.Mismatched("it repeats a different question"))
    }
    // The low four bits of the last flag byte are the response code.
    let rcode = int(message[3]) % 16
    if rcode != 0 {
        return Err(DnsError.Refused(rcode))
    }
    let questions = int(message[4]) * 256 + int(message[5])
    let answers = int(message[6]) * 256 + int(message[7])
    if answers == 0 {
        return Err(DnsError.NoAddress(name))
    }
    var at = 12
    var asked = 0
    while asked < questions {
        at = skip_name(message, at)?
        // QTYPE and QCLASS.
        at += 4
        asked += 1
    }
    var seen = 0
    while seen < answers {
        at = skip_name(message, at)?
        if at + 10 > message.len() {
            return Err(DnsError.Malformed("a record is cut short"))
        }
        let kind = int(message[at]) * 256 + int(message[at + 1])
        let length = int(message[at + 8]) * 256 + int(message[at + 9])
        at += 10
        if at + length > message.len() {
            return Err(DnsError.Malformed("a record claims more data than the answer holds"))
        }
        // Type A, and exactly the four bytes an IPv4 address is.
        if kind == 1 && length == 4 {
            return Ok("${int(message[at])}.${int(message[at + 1])}.${int(message[at + 2])}.${int(message[at + 3])}")
        }
        at += length
        seen += 1
    }
    return Err(DnsError.NoAddress(name))
}

// Whether the answer repeats the question that was asked, byte for byte from
// the end of the header onwards — the name, the type and the class together.
//
// Case is ignored. A server is free to change the case of a letter in the name
// it echoes, which is the property 0x20 encoding is built on, and a byte-exact
// comparison would reject a perfectly good answer from one that does.
func echoes_question(message: []u8, question: []u8) -> bool {
    if message.len() < question.len() {
        return false
    }
    var at = 12
    while at < question.len() {
        if lowered(message[at]) != lowered(question[at]) {
            return false
        }
        at += 1
    }
    return true
}

func lowered(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 {
        return byte + 32
    }
    return byte
}

// Step over a name without expanding it. A label whose length byte is 192 or
// more is a pointer to earlier in the message, and ends the name in two bytes.
func skip_name(message: []u8, start: int) -> Result<int, DnsError> {
    var at = start
    var steps = 0
    while at < message.len() {
        if steps > 128 {
            return Err(DnsError.Malformed("a name loops"))
        }
        let length = int(message[at])
        if length >= 192 {
            return Ok(at + 2)
        }
        if length == 0 {
            return Ok(at + 1)
        }
        at += length + 1
        steps += 1
    }
    return Err(DnsError.Malformed("a name runs past the end of the answer"))
}
