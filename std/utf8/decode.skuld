// Strict UTF-8, with an error that names what went wrong and where.
//
// The builtin `bytes_to_string` validates the same bytes but can only say so
// with a message, because the language has no error type of its own to return.
// This module is where that type lives: the library owns it, and the compiler
// stays out of it.

pub enum Utf8Error {
    // Each payload is the byte offset where the faulty sequence starts.
    Truncated(int),
    Overlong(int),
    Surrogate(int),
    TooLarge(int),
    Invalid(int),
}

pub func describe(error: Utf8Error) -> string {
    match error {
        Utf8Error.Truncated(at): return "truncated sequence at byte ${at}"
        Utf8Error.Overlong(at): return "overlong encoding at byte ${at}"
        Utf8Error.Surrogate(at): return "surrogate half at byte ${at}"
        Utf8Error.TooLarge(at): return "code point above U+10FFFF at byte ${at}"
        Utf8Error.Invalid(at): return "invalid byte at byte ${at}"
    }
}

// The offset of the faulty sequence, for a caller that wants to slice around it.
pub func offset(error: Utf8Error) -> int {
    match error {
        Utf8Error.Truncated(at): return at
        Utf8Error.Overlong(at): return at
        Utf8Error.Surrogate(at): return at
        Utf8Error.TooLarge(at): return at
        Utf8Error.Invalid(at): return at
    }
}

// Rejects what a lax validator waves through: overlong encodings, surrogate
// halves and anything above U+10FFFF. Returns the number of code points.
pub func validate(bytes: []u8) -> Result<int, Utf8Error> {
    var index = 0
    var points = 0
    while index < bytes.len() {
        let first = int(bytes[index])
        var width = 0
        var value = 0
        if first < 0x80 {
            width = 1
            value = first
        } else if first >= 0xC2 && first < 0xE0 {
            // 0xC0 and 0xC1 can only begin an overlong two-byte sequence.
            width = 2
            value = first & 0x1F
        } else if first >= 0xE0 && first < 0xF0 {
            width = 3
            value = first & 0x0F
        } else if first >= 0xF0 && first < 0xF5 {
            width = 4
            value = first & 0x07
        } else {
            return Err(Utf8Error.Invalid(index))
        }
        if index + width > bytes.len() {
            return Err(Utf8Error.Truncated(index))
        }
        var k = 1
        while k < width {
            let continuation = int(bytes[index + k])
            if continuation & 0xC0 != 0x80 {
                return Err(Utf8Error.Truncated(index))
            }
            value = (value << 6) | (continuation & 0x3F)
            k += 1
        }
        if width == 3 && value < 0x800 {
            return Err(Utf8Error.Overlong(index))
        }
        if width == 4 && value < 0x10000 {
            return Err(Utf8Error.Overlong(index))
        }
        if value >= 0xD800 && value < 0xE000 {
            return Err(Utf8Error.Surrogate(index))
        }
        if value > 0x10FFFF {
            return Err(Utf8Error.TooLarge(index))
        }
        index += width
        points += 1
    }
    return Ok(points)
}

// What a caller reaches for: bytes in, a string or a named error out.
pub func decode(bytes: []u8) -> Result<string, Utf8Error> {
    let points = validate(bytes)?
    match bytes_to_string(bytes) {
        Ok(text): return Ok(text)
        // Unreachable: `validate` accepted these bytes, and the builtin applies
        // the same rules. Returning rather than trapping keeps it that way if
        // one of the two ever drifts.
        Err(reason): return Err(Utf8Error.Invalid(0))
    }
}

// The number of code points, without building a string.
pub func count(bytes: []u8) -> Result<int, Utf8Error> {
    return validate(bytes)
}
