// A blocking TCP connection, over the libc sockets the FFI can reach.
//
// Two limits are structural rather than temporary, and both come from
// `AGENTS.md` putting pointer reads out of scope for the foreign boundary.
//
// There is no name resolution. `getaddrinfo` and `gethostbyname` both answer
// with a pointer to a structure, and Skuld cannot dereference one, so a
// connection is made to an address and never to a name. Resolving names needs
// either a read primitive at the boundary or a resolver written in Skuld over
// UDP; both are decisions of their own.
//
// A failure does say why, and it asks the platform layer rather than `errno`:
// a socket error is reported somewhere else entirely on Windows, in a range
// of numbers of its own, so reading `errno` after a socket call would answer
// about whatever happened before it.
//
// The address crosses as its four octets and the layer builds the structure
// the system wants from them. That is deliberate: `struct sockaddr_in` agrees
// between the two systems by luck rather than by rule, and the arithmetic
// that puts a port in network order is the kind of thing that is wrong in
// exactly one place and silent about it.

import "std/os"

// Connecting, reading and writing go through the platform layer, and the
// numbers that used to be written here went with them. Nearly every
// difference between two systems lives in this one area: a socket is an `int`
// on POSIX and a pointer-wide `SOCKET` elsewhere, failure is -1 on one and
// all-bits-set on the other, writing to a closed connection needs a flag on
// one and rejects it on the other, and a receive timeout is a `struct
// timeval` here and a count of milliseconds there. None of that can be
// written down once and be right twice, so it is not written down here at
// all: a handle is an `int`, a timeout is milliseconds, an address is four
// octets, and the layer knows what those mean where it is compiled.
unsafe extern "C" {
    func sk_socket_connect(octets: *u8, port: i64, datagram: i64) -> i64
    func sk_socket_send(handle: i64, buffer: *u8, length: u64) -> i64
    func sk_socket_recv(handle: i64, buffer: *u8, capacity: u64) -> i64
    func sk_socket_close(handle: i64) -> void
    func sk_socket_error() -> i64
}

pub enum NetError {
    // The text was not four decimal octets separated by dots.
    Address(string),
    // The port was outside 1..65535.
    Port(int),
    // Each of these carries what was being attempted and the system's reason.
    OpenFailed(os.OsFailure),
    ConnectFailed(os.OsFailure),
    SendFailed(os.OsFailure),
    ReceiveFailed(os.OsFailure),
}

pub func describe(error: NetError) -> string {
    match error {
        NetError.Address(text): return "`${text}` is not an IPv4 address"
        NetError.Port(value): return "port ${value} is out of range"
        NetError.OpenFailed(problem): return "could not open ${os.describe_failure(problem)}"
        NetError.ConnectFailed(problem): return "could not connect to ${os.describe_failure(problem)}"
        NetError.SendFailed(problem): return "could not send to ${os.describe_failure(problem)}"
        NetError.ReceiveFailed(problem): return "could not receive from ${os.describe_failure(problem)}"
    }
}

// Four decimal octets, parsed here rather than through `inet_pton`, which
// would be one more foreign call for arithmetic Skuld can do itself.
pub func parse_address(text: string) -> Result<[]u8, NetError> {
    var octets: []u8 = []
    var value = 0
    var digits = 0
    var index = 0
    while index < text.len() {
        let byte = text[index]
        if byte >= 48 && byte <= 57 {
            value = value * 10 + (int(byte) - 48)
            digits = digits + 1
            if value > 255 || digits > 3 {
                return Err(NetError.Address(text))
            }
        } else if byte == 46 {
            if digits == 0 {
                return Err(NetError.Address(text))
            }
            octets.push(u8(value))
            value = 0
            digits = 0
        } else {
            return Err(NetError.Address(text))
        }
        index = index + 1
    }
    if digits == 0 {
        return Err(NetError.Address(text))
    }
    octets.push(u8(value))
    if octets.len() != 4 {
        return Err(NetError.Address(text))
    }
    return Ok(octets)
}

pub class Connection {
    handle: int
    // Where this connection goes, so a failure can say which peer it was.
    peer: string = "the peer"

    // `MSG_NOSIGNAL`, so that writing to a connection the peer has closed
    // fails as a return value instead of killing the process with SIGPIPE.
    send_all(bytes: []u8) -> Result<int, NetError> {
        var sent = 0
        while sent < bytes.len() {
            let rest = bytes[sent..bytes.len()]
            let wrote = sk_socket_send(i64(this.handle), ptr(rest), u64(rest.len()))
            if wrote <= 0 {
                return Err(NetError.SendFailed(failure(this.peer)))
            }
            sent = sent + int(wrote)
        }
        return Ok(sent)
    }

    // One read. An empty result means the peer closed the connection, which
    // is how a caller knows a body without a length has ended.
    receive(limit: int) -> Result<[]u8, NetError> {
        var buffer: []u8 = []
        var index = 0
        while index < limit {
            buffer.push(0)
            index = index + 1
        }
        let got = sk_socket_recv(i64(this.handle), ptr(buffer), u64(limit))
        if got < 0 {
            return Err(NetError.ReceiveFailed(failure(this.peer)))
        }
        return Ok(buffer[0..int(got)])
    }

    // Reads until the peer closes, which is what an HTTP/1.0-style response
    // without a length requires.
    receive_all() -> Result<[]u8, NetError> {
        var all: []u8 = []
        var buffer: [4096]u8 = [0; 4096]
        loop {
            let got = sk_socket_recv(i64(this.handle), ptr(buffer), u64(4096))
            if got < 0 {
                return Err(NetError.ReceiveFailed(failure(this.peer)))
            }
            if got == 0 {
                break
            }
            for byte in buffer[0..int(got)] {
                all.push(byte)
            }
        }
        return Ok(all)
    }

    close() {
        sk_socket_close(i64(this.handle))
    }
}

// Four octets as one host-order `u32`, which `htonl` then puts in network
// order. The shifts are the value's arithmetic, not the machine's layout.
func packed_address(octets: []u8) -> u32 {
    return (u32(octets[0]) << 24) | (u32(octets[1]) << 16) | (u32(octets[2]) << 8) | u32(octets[3])
}

pub func open(address: string, port: int) -> Result<Connection, NetError> {
    if port < 1 || port > 65535 {
        return Err(NetError.Port(port))
    }
    let octets = parse_address(address)?
    let handle = sk_socket_connect(ptr(octets), i64(port), 0)
    if handle < 0 {
        return Err(NetError.ConnectFailed(failure("${address}:${port}")))
    }
    return Ok(new Connection(handle: int(handle), peer: "${address}:${port}"))
}

// A socket failure the way `std/os` shapes every other one, but read from
// where the system actually left it: Winsock never touches `errno`, and its
// numbers are a range of their own, so asking `os.last_error()` after a
// socket call answers about something else entirely.
func failure(subject: string) -> os.OsFailure {
    return new os.OsFailure(subject: subject, code: int(sk_socket_error()))
}
