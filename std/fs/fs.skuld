// Reading and writing a whole file, over the libc calls the FFI can reach.
//
// The API is by path, not by handle: `read_file` and `write_file` open,
// finish and close in one call. That is a decision, not a simplification.
// A handle exposed to Skuld would need a lifetime rule — who closes it, and
// what happens to one that is dropped — and Skuld has no destructors a user
// can write. A path-shaped API needs none of that, and a file transformed
// whole is what a command-line tool does anyway.
//
// There is no `errno` here either, for the reason `std/net` records: reading
// it means reading through a pointer, which the foreign boundary does not do.
// A failure therefore says which step failed and on which path, never why.

import "std/cstring"
import "std/os"

// Opening a file goes through the platform layer rather than naming `open`
// here, and the flags went with it. They were written down as the Linux
// numbers — `O_CREAT` is 64 there and 256 on Windows, and `O_BINARY` exists
// on one system and not the other — so a declaration here has to pick one
// system and be quietly wrong on the rest. The layer asks the header of the
// system being built for, which is the only place those numbers are known.
unsafe extern "C" {
    func sk_file_open(path: *u8, writing: i64) -> i64
    func sk_file_read(handle: i64, buffer: *u8, capacity: u64) -> i64
    func sk_file_write(handle: i64, buffer: *u8, count: u64) -> i64
    func sk_file_close(handle: i64) -> void
}

pub enum FsError {
    // The path contained a NUL, so it could not become a C string.
    Path(string),
    // Each of these carries the path and the system's reason.
    OpenFailed(os.OsFailure),
    ReadFailed(os.OsFailure),
    WriteFailed(os.OsFailure),
    // The bytes read are not the UTF-8 `read_text` promised.
    NotText(string),
}

pub func describe(error: FsError) -> string {
    match error {
        FsError.Path(path): return "`${path}` is not a usable path"
        FsError.OpenFailed(problem): return "could not open ${os.describe_failure(problem)}"
        FsError.ReadFailed(problem): return "could not read ${os.describe_failure(problem)}"
        FsError.WriteFailed(problem): return "could not write ${os.describe_failure(problem)}"
        FsError.NotText(path): return "`${path}` is not valid UTF-8"
    }
}

// Every byte of a file, read in blocks until the end.
pub func read_file(path: string) -> Result<[]u8, FsError> {
    let handle = open_path(path, 0)?
    var all: []u8 = []
    var block: [4096]u8 = [0; 4096]
    loop {
        let got = sk_file_read(i64(handle), ptr(block), u64(4096))
        if got < 0 {
            let problem = os.failure("`${path}`")
            sk_file_close(i64(handle))
            return Err(FsError.ReadFailed(problem))
        }
        if got == 0 {
            break
        }
        for byte in block[0..int(got)] {
            all.push(byte)
        }
    }
    sk_file_close(i64(handle))
    return Ok(all)
}

// The same, decoded as UTF-8, which is what a text tool wants.
pub func read_text(path: string) -> Result<string, FsError> {
    let bytes = read_file(path)?
    let text = bytes_to_string(bytes) else message {
        return Err(FsError.NotText(path))
    }
    return Ok(text)
}

// Replace a file with these bytes, creating it if it is not there.
pub func write_file(path: string, bytes: []u8) -> Result<int, FsError> {
    let handle = open_path(path, 1)?
    var written = 0
    while written < bytes.len() {
        let rest = bytes[written..bytes.len()]
        let wrote = sk_file_write(i64(handle), ptr(rest), u64(rest.len()))
        if wrote <= 0 {
            let problem = os.failure("`${path}`")
            sk_file_close(i64(handle))
            return Err(FsError.WriteFailed(problem))
        }
        written += int(wrote)
    }
    sk_file_close(i64(handle))
    return Ok(written)
}

pub func write_text(path: string, text: string) -> Result<int, FsError> {
    return write_file(path, text.bytes())
}

// Opening is the one step both halves share, and the only one that needs the
// path as a C string. `writing` is 1 to replace the file and 0 to read it;
// which flags that means is the platform layer's to decide.
func open_path(path: string, writing: i64) -> Result<int, FsError> {
    let terminated = cstring.to_c(path) else problem {
        return Err(FsError.Path(path))
    }
    let handle = sk_file_open(ptr(terminated), writing)
    if handle < 0 {
        return Err(FsError.OpenFailed(os.failure("`${path}`")))
    }
    return Ok(int(handle))
}
