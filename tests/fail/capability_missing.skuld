// A generic body may use `==` only on a parameter that requires `Equatable`,
// and `compare` only on one that requires `Comparable`.
func same<T>(a: T, b: T) -> bool {
    return a == b
}

func bigger<T: Equatable>(a: T, b: T) -> bool {
    return a.compare(b) == .Greater
}

func main() {
    print(same(1, 2))
}
