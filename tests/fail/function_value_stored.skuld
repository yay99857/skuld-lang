// An array, an Option and an enum payload are all places a function value
// could outlive the frame that built it.
enum Wrap {
    V((int) -> int)
}

func main() {
    let actions: [](int) -> int = []
    let maybe: Option<(int) -> int> = null
}

func inferred() {
    let f = (n: int): int { return n }
    // Neither of these writes a type, so the escape rule has to reach what
    // was inferred rather than only what was annotated.
    let collected = [f]
    let wrapped = Some(f)
}
