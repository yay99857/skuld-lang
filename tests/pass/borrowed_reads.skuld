// Reading a binding does not take a reference of its own — the binding is the
// reference — and this is the fixture that has to stay true for that to be
// safe. Every case here uses a value while something else is letting go of it.

class Box {
    value: string
}

// The array holds the only reference and the inner block drops it for good.
// The parameter survives because the caller's own binding does.
func drop_then_use(box: Box, boxes: []Box) {
    if true {
        let removed = boxes.remove(0)
    }
    print(box.value)
}

func longest(left: string, right: string) -> string {
    if left.len() >= right.len() {
        return left
    }
    return right
}

// A value returned from a borrowed parameter is retained on the way out, so it
// outlives the collection it came from.
func take_first(texts: []string) -> string {
    let first = texts[0]
    let removed = texts.remove(0)
    return first
}

// Reading through a field borrows the storage too, but only when nothing
// between the read and the use can run. Here the index runs a method that
// replaces the very field being read, so the read takes a count instead — and
// still sees the array it started with, because the object is evaluated
// before the index.
class Buffer {
    data: []u8
    at: int = 0

    read_while_replacing() -> u8 {
        return this.data[this.replace()]
    }

    replace() -> int {
        this.data = [9, 9, 9]
        return 0
    }

    first() -> u8 {
        return this.data[this.at]
    }

    size() -> int {
        return this.data.len()
    }
}

func main() {
    var boxes: []Box = []
    boxes.push(new Box(value: "alive"))
    drop_then_use(boxes[0], boxes)

    var texts: []string = []
    texts.push("held" + "-together")
    print(take_first(texts))
    print(texts.len())

    // A local that outlives the array it was read from.
    var more: []Box = []
    more.push(new Box(value: "kept"))
    let item = more[0]
    let removed = more.remove(0)
    print(item.value)

    // Two borrows in one expression, one of which is a fresh value.
    let name = "skuld"
    print(longest(name, name + "-lang"))

    let buffer = new Buffer(data: [1, 2, 3])
    print(buffer.first())
    print(buffer.read_while_replacing())
    print(buffer.first())
    print(buffer.size())

    // A field read through `this` while the object is also in an array.
    var boxed: []Box = []
    boxed.push(new Box(value: "field"))
    let kept = boxed[0]
    boxed.pop()
    print(kept.value)
}
