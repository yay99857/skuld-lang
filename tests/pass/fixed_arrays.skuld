unsafe extern "C" {
    func pipe(fds: *i32) -> i32
    func close(fd: i32) -> i32
}

func print_slice(items: []int) {
    for item in items {
        print(item)
    }
}

struct Packet {
    id: int,
    payload: [4]u8,
}

class Buffer {
    data: [8]int,
}

func main() {
    let arr1: [4]int = [42; 4]
    print(arr1.len())
    print(arr1[0])
    print(arr1[3])

    let arr2: [3]int = [10, 20, 30]
    print(arr2[0])
    print(arr2[1])
    print(arr2[2])

    var original: [3]int = [1, 2, 3]
    var copy = original
    copy[0] = 99
    print(original[0])
    print(copy[0])

    for x in arr2 {
        print(x)
    }

    let slice = original[1..3]
    print(slice.len())
    print(slice[0])
    print(slice[1])

    print_slice(arr2)

    let text_bytes: [5]u8 = [104, 101, 108, 108, 111]
    let s = bytes_to_string(text_bytes) else problem {
        print("fail")
        return
    }
    print(s)

    var pkt = Packet { id: 1, payload: [0; 4] }
    pkt.payload[2] = 255
    print(int(pkt.payload[2]))

    let buf = new Buffer(data: [0; 8])
    buf.data[5] = 123
    print(buf.data[5])

    var fds: [2]i32 = [0, 0]
    let res = pipe(ptr(fds))
    if res == 0 && fds[0] > 0 && fds[1] > 0 {
        print("pipe ok")
        let ignored0 = close(fds[0])
        let ignored1 = close(fds[1])
    }
}
