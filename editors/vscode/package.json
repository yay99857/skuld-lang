{
  "name": "skuld",
  "displayName": "Skuld",
  "description": "Syntax highlighting and language server support for Skuld",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "skuld",
  "repository": {
    "type": "git",
    "url": "https://github.com/yay99857/skuld-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:skuld"],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "skuld",
        "aliases": ["Skuld", "skuld"],
        "extensions": [".skuld", ".sk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skuld",
        "scopeName": "source.skuld",
        "path": "./syntaxes/skuld.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Skuld",
      "properties": {
        "skuld.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where `skuld-lsp` is. Empty looks for it on `PATH`, then in this checkout's `target/release` and `target/debug`."
        }
      }
    }
  }
}
