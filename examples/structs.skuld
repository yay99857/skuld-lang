struct Rectangle {
    width: int
    height: int

    // Methods carry no `func` keyword and no receiver parameter; `this` is the
    // current value, and it is a copy, so a method cannot modify the caller.
    area(): int {
        return this.width * this.height
    }

    grown(by: int): Rectangle {
        return Rectangle { width: this.width + by, height: this.height + by }
    }
}

func main() {
    var base = Rectangle { width: 3, height: 4 }
    print(base.area())

    // Structs copy on assignment, so `base` keeps its own values.
    let bigger = base.grown(2)
    print(bigger.area())
    print(base.area())

    base.width = 10
    print(base.area())
}
