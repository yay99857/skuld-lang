func sum(values: []int): int {
    var total = 0
    var index = 0
    while index < values.len() {
        total += values[index]
        index += 1
    }
    return total
}

func main() {
    let numbers = [1, 4, 6, 7, 3]
    let alias = numbers
    alias[0] = 10
    print(sum(numbers)) // 30

    // Dynamic array growth: push and pop
    numbers.push(100)
    print(numbers.len()) // 6
    if let last = numbers.pop() {
        print(last) // 100
    }

    // Insertion and removal
    numbers.insert(0, 99)
    print(numbers[0]) // 99
    if let removed = numbers.remove(0) {
        print(removed) // 99
    }

    let rows: [][]string = [[], ["hello" + "!"]]
    rows[0] = ["Skuld"]
    print(rows[0][0])
    print(rows[1][0])
}
