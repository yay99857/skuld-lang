class User { name: string }

func find_answer(found: bool): Option<int> {
    if found { return 42 }
    return null
}

func main() {
    if let answer = find_answer(true) {
        print(answer)
    } else {
        print("No answer")
    }

    var observer: weak User = weak()
    {
        let user = new User(name: "Ada")
        observer = weak(user)
        if let retained = observer.upgrade() {
            print(retained.name)
        }
    }

    if let retained = observer.upgrade() {
        print(retained.name)
    } else {
        print("User has expired")
    }
}
